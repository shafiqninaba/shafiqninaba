---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PERSON, SITE } from '../data/site';

const canonical = `${SITE.origin}/about`;
const description =
  'About Shafiq Ninaba, an AI Engineer in Singapore building production machine-learning systems.';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: 'About Shafiq Ninaba',
  description,
  isPartOf: { '@id': `${SITE.origin}/#website` },
  about: { '@id': `${SITE.origin}/#person` },
});
---

<BaseLayout
  title="About | Shafiq Ninaba"
  description={description}
  canonical={canonical}
  ogImage={SITE.ogImage}
  ogImageAlt={SITE.ogImageAlt}
  jsonLd={jsonLd}
>
  <article class="info-page">
    <header class="info-page__header">
      <p class="t-label-default-s c-brand-weak">About</p>
      <h1 class="t-display-strong-s">{PERSON.name}</h1>
      <p class="t-body-default-l c-neutral-weak">{PERSON.role} · Singapore</p>
    </header>

    <section class="info-page__section" aria-labelledby="background-heading">
      <h2 id="background-heading" class="t-heading-strong-l">Background</h2>
      <p class="t-body-default-m">
        I am a Singapore-based AI Engineer focused on taking machine-learning ideas from an
        experiment into a dependable product. My work spans computer vision, data engineering,
        MLOps, cloud infrastructure, and LLM-powered agentic workflows. I care about the practical
        parts of delivery: clear interfaces, reproducible training and deployment, observability,
        documentation, and systems that teams can operate after handover.
      </p>
      <p class="t-body-default-m">
        I currently work at AI Singapore, where I contribute to an enterprise AI-powered Learning
        Management System and own much of its MLOps and DevOps infrastructure. Earlier, as an
        Associate AI Engineer, I delivered a construction-industry computer-vision MVP and built
        a production pipeline for 360-degree panoptic segmentation. I also worked on predictive
        maintenance and data automation during a machine-learning internship at PSA Corporation.
      </p>
    </section>

    <section class="info-page__section" aria-labelledby="education-heading">
      <h2 id="education-heading" class="t-heading-strong-l">Education and interests</h2>
      <p class="t-body-default-m">
        I hold a Bachelor of Engineering in Electrical and Electronic Engineering, Honours
        (Distinction), from Nanyang Technological University, with a focus on Info-Communications
        Engineering. My current technical interests include platform engineering for ML, cloud
        deployment on Azure, Kubernetes-based operations, computer vision, and reliable interfaces
        between language models and real-world tools. Outside work, I enjoy bouldering and keeping
        up with new AI models, software-engineering frameworks, and useful technology.
      </p>
    </section>

    <section class="info-page__section" aria-labelledby="purpose-heading">
      <h2 id="purpose-heading" class="t-heading-strong-l">Purpose of this site</h2>
      <p class="t-body-default-m">
        This portfolio is a first-party reference for my experience, skills, education, and public
        professional links. It is intentionally straightforward: the homepage contains the full
        profile, while the <a href="/contact">contact page</a> explains how to reach me and the
        <a href="/privacy">privacy page</a> explains the site's data practices. Agents and other
        text-first clients can use <a href="/llms.txt">llms.txt</a> for guidance on when this
        profile is an appropriate source.
      </p>
    </section>
  </article>
</BaseLayout>
