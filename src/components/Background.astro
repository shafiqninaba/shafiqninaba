---
/**
 * Background — fixed gradient + dots + 45° lines effect layer. Spec §E.2.
 *
 * ZERO JS. The original's requestAnimationFrame cursor-tracking mask is replaced
 * by a STATIC mask built from the original config's own non-cursor fallback
 * coordinates (x: 50, y: 0, radius: 100).
 */
---

<div class="bg" aria-hidden="true">
  <div class="bg__gradient"></div>
  <div class="bg__dots"></div>
  <div class="bg__lines"></div>
</div>

<style>
  /* The mask goes on the CONTAINER, never on the individual layers. */
  .bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    /* The original masks this layer with a radial gradient centred on the cursor.
       With zero JS there is no cursor, so we use the SAME fallback the original
       itself paints before the first pointer event — and which it therefore also
       paints for every crawler, every screenshot and every touch device: 0, 0.
       `50% 0%` (the earlier value) parks the mask's opaque core directly over the
       gradient's hot spot at 50%/60%, which is what made the whole viewport read
       as a heavy green wash and dragged body-text contrast down. At `0% 0%` the
       mask decays to zero well before the hot spot, leaving the restrained
       lower-left glow over near-black that the original shows.
       The dots and lines layers are masked by the same container, so this is
       also what pulls the 45° lines back to the original's visibility — their
       own opacities (0.4 / 1) already match the original exactly. */
    -webkit-mask-image: radial-gradient(100vh at 0% 0%, #000 0%, transparent 100%);
    mask-image: radial-gradient(100vh at 0% 0%, #000 0%, transparent 100%);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  .bg__gradient,
  .bg__dots,
  .bg__lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Equivalent of the original 400%-sized box with x=50,y=60,w=100,h=50 remapped.
     Do NOT "simplify" to 100% / 50% — these numbers are derived. */
  .bg__gradient {
    opacity: 1;
    background: radial-gradient(
      ellipse 100vw 50vh at 50% 60%,
      var(--accent-background-strong) 0%,
      var(--page-background) 100%
    );
  }

  /* dots.size="2" = --static-space-2 = 0.125rem = 2px tile with 1px dots. Very fine texture. */
  .bg__dots {
    opacity: 0.4;
    background-image: radial-gradient(var(--brand-background-strong) 1px, rgba(0, 0, 0, 0) 1px);
    background-size: 2px 2px;
  }

  /* Both calc(1rem - 1px) stops must be the SAME expression or the lines
     anti-alias unevenly. No background-size here — the original SCSS referenced
     an undefined --lines-size and the declaration was invalid. */
  .bg__lines {
    opacity: 1;
    background: repeating-linear-gradient(
      45deg,
      rgba(0, 0, 0, 0),
      rgba(0, 0, 0, 0) calc(1rem - 1px),
      var(--neutral-alpha-weak) calc(1rem - 1px),
      var(--neutral-alpha-weak) 1rem
    );
  }
</style>
