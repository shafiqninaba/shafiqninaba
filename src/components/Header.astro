---
/**
 * Header — the sticky pill nav.
 *
 * Icon-only: GitHub / LinkedIn / Email carry `aria-label`s and a CSS-only
 * tooltip, no visible text. The theme toggle sits after a hairline separator,
 * matching the starfolio dock's layout.
 *
 * Hover behaviour is starfolio's magicui <Dock>: items magnify by proximity to
 * the cursor, pushing their neighbours apart. Ported to ~350 B of vanilla JS in
 * src/scripts/app.ts (contract: `[data-dock]` / `[data-dock-item]`) with the
 * same constants — 40px base, 60px magnified, 100px falloff — instead of the
 * template's motion/react springs. Degrades to plain hover states with no JS,
 * under `prefers-reduced-motion`, and on coarse pointers.
 *
 * Icons are Astro SVG components compiled from local .svg imports: inline SVG,
 * zero JS, zero extra network requests. All inherit `currentColor`.
 */
import EnvelopeSvg from '../assets/icons/envelope.svg';
import GithubSvg from '../assets/icons/github.svg';
import GlobeSvg from '../assets/icons/globe.svg';
import LinkedinSvg from '../assets/icons/linkedin.svg';
import { PERSON } from '../data/site';
---

<header class="header">
  <div class="header__side header__side--left t-body-default-s">
    <GlobeSvg class="header__globe" aria-hidden="true" />
    {PERSON.locationLabel}
  </div>

  <div class="header__pill">
    <nav class="header__pill-inner" aria-label="Social profiles" data-dock>
      <a
        class="pill-btn"
        data-dock-item
        data-tip="GitHub"
        href="https://github.com/shafiqninaba"
        rel="me noopener"
        target="_blank"
        aria-label="GitHub profile"
      >
        <GithubSvg aria-hidden="true" />
      </a>
      <a
        class="pill-btn"
        data-dock-item
        data-tip="LinkedIn"
        href="https://www.linkedin.com/in/shafiq-ninaba/"
        rel="me noopener"
        target="_blank"
        aria-label="LinkedIn profile"
      >
        <LinkedinSvg aria-hidden="true" />
      </a>
      <a
        class="pill-btn"
        data-dock-item
        data-tip="Email"
        href={`mailto:${PERSON.email}`}
        aria-label="Email Shafiq Ninaba"
      >
        <EnvelopeSvg aria-hidden="true" />
      </a>

      <span class="header__sep" aria-hidden="true"></span>

      {/*
        Rendered by the server in its dark-mode state. The inline script in
        BaseHead sets data-theme before first paint, and `aria-pressed` is
        corrected by the same script, so there is no flash and no wrong label.
      */}
      <button
        class="pill-btn"
        data-dock-item
        data-tip="Theme"
        data-theme-toggle
        type="button"
        aria-label="Switch to light theme"
        aria-pressed="false"
      >
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </nav>
  </div>

  {/* Static string, NOT a live clock: JS would render "" then "14:32" and cost CLS. */}
  <div class="header__side header__side--right t-body-default-s">{PERSON.utcOffsetLabel}</div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 9;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: fit-content;
    padding: 0.5rem;
  }

  .header__side {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
  }
  .header__side--left {
    padding-left: 0.75rem;
  }
  .header__side--right {
    justify-content: flex-end;
    padding-right: 0.75rem;
    gap: 1.25rem;
  }
  .header__globe {
    width: 1rem;
    height: 1rem;
    color: var(--accent-on-background-weak);
  }

  @media (max-width: 768px) {
    .header {
      position: fixed;
      top: auto;
      bottom: 1.5rem;
    }
    .header__side {
      display: none;
    }
  }

  /* THE PILL — radius comes from the ROUNDED scale (1.5rem), not playful (1rem). */
  .header__pill {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
    border: 1px solid var(--neutral-alpha-medium);
    border-radius: var(--radius-rounded-m-nest-4);
    background-color: var(--surface-background);
    -webkit-backdrop-filter: var(--backdrop-filter);
    backdrop-filter: var(--backdrop-filter);
    box-shadow: var(--shadow-l);
  }
  .header__pill-inner {
    display: flex;
    /* align-items:end so magnified items grow upward out of the pill like a
       macOS dock, rather than expanding it symmetrically. */
    align-items: flex-end;
    gap: 0.25rem;
    /* Tall enough that a 60px magnified item never clips. */
    min-height: 2.5rem;
  }

  .header__sep {
    width: 1px;
    height: 1.25rem;
    margin: 0 0.125rem;
    align-self: center;
    background: var(--neutral-alpha-medium);
  }

  /* `a:not(.btn)` in base.css would colour these links green. It resolves to
     (0,1,1), so the selector below is qualified with `a` to match that
     specificity exactly — component styles come last in the cascade, so it wins
     on source order. Do not rename the class or drop the `a`. */
  a.pill-btn,
  button.pill-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    /* --sz is written by the dock script; 2.5rem is the un-magnified base and
       the value every no-JS / reduced-motion / touch visitor keeps. */
    width: var(--sz, 2.5rem);
    height: var(--sz, 2.5rem);
    flex: none;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 50%;
    background: transparent;
    color: var(--neutral-on-background-strong);
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    transition: background-color 0.2s ease-in-out, border-color 0.2s ease-in-out,
      color 0.2s ease-in-out;
  }
  a.pill-btn:hover,
  a.pill-btn:focus-visible,
  button.pill-btn:hover,
  button.pill-btn:focus-visible {
    background: var(--neutral-alpha-weak);
    border-color: var(--neutral-alpha-weak);
    color: var(--neutral-on-background-strong);
  }
  .pill-btn :global(svg),
  .pill-btn > svg {
    width: var(--icon-sz, 1rem);
    height: var(--icon-sz, 1rem);
    flex: none;
  }

  /* CSS-only tooltip, matching the template's floating label. */
  .pill-btn::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-m);
    background: var(--neutral-on-background-strong);
    color: var(--page-background);
    font-family: var(--font-family-label);
    font-size: 0.75rem;
    line-height: 1.125rem;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 0.25rem);
    transition: opacity 0.15s ease-out, transform 0.15s ease-out;
  }
  .pill-btn:hover::after,
  .pill-btn:focus-visible::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  /* The bottom-docked mobile pill would clip a tooltip drawn above it. */
  @media (max-width: 768px) {
    .pill-btn::after {
      display: none;
    }
  }

  /* Only one of the two theme glyphs shows at a time. Dark is the default, so
     the SUN (the action: "switch to light") is what shows first. */
  .icon-moon {
    display: none;
  }
  :global([data-theme='light']) .icon-sun {
    display: none;
  }
  :global([data-theme='light']) .icon-moon {
    display: block;
  }

  /* The dock magnification is motion; honour the OS preference by pinning size. */
  @media (prefers-reduced-motion: reduce) {
    a.pill-btn,
    button.pill-btn {
      width: 2.5rem !important;
      height: 2.5rem !important;
    }
    .pill-btn :global(svg),
    .pill-btn > svg {
      width: 1rem !important;
      height: 1rem !important;
    }
  }
</style>
