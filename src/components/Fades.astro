---
/**
 * Fades — the bottom (mobile) blur/fade overlay. Zero JS, zero props.
 *
 * The matching TOP fade is deliberately gone. It was a fixed 5rem overlay
 * painting `linear-gradient(var(--page-background), transparent)` from y=16 —
 * i.e. the page colour — directly over the flickering-grid backdrop, punching a
 * dark band through the middle of it and leaving a visible seam where the grid
 * re-emerged below. The grid now provides the top-edge treatment the fade used
 * to, so the two cannot coexist.
 */
---

<div class="fade fade--bottom" aria-hidden="true"></div>

<style>
  .fade {
    position: fixed;
    left: 0;
    width: 100%;
    height: 5rem;
    z-index: 9;
    pointer-events: none;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  .fade--bottom {
    display: none;
    top: auto;
    bottom: 0;
    -webkit-backdrop-filter: blur(0.5rem);
    backdrop-filter: blur(0.5rem);
    background: linear-gradient(0deg, var(--page-background), transparent);
    -webkit-mask-image: linear-gradient(0deg, #000 20%, transparent 100%);
    mask-image: linear-gradient(0deg, #000 20%, transparent 100%);
  }

  @media (max-width: 768px) {
    .fade--bottom {
      display: block;
    }
  }
</style>
