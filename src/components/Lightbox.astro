---
// §E.9 — the single native <dialog> overlay, rendered once per page.
// Esc-to-close, focus trapping, page inertness and top-layer stacking come from
// the browser. The close button is a <form method="dialog"> submit button, so it
// needs no JS listener at all. src/scripts/app.ts only fills in the image and
// calls showModal(). No props.
---

<dialog id="lightbox" class="lightbox" aria-label="Enlarged image">
  <img class="lightbox__img" alt="" />
  <form method="dialog">
    <button class="lightbox__close" aria-label="Close">&times;</button>
  </form>
</dialog>

<style>
  .lightbox {
    padding: 0;
    border: none;
    background: transparent;
    max-width: min(92vw, 1600px);
    max-height: 92vh;
    overflow: visible;
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.78);
    -webkit-backdrop-filter: blur(0.5rem);
    backdrop-filter: blur(0.5rem);
  }
  .lightbox__img {
    display: block;
    max-width: 100%;
    max-height: 92vh;
    width: auto;
    height: auto;
    border-radius: var(--radius-m);
    border: 1px solid var(--neutral-border-medium);
    box-shadow: var(--shadow-xl);
  }
  .lightbox__close {
    position: absolute;
    top: -0.5rem;
    right: -0.5rem;
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--neutral-alpha-medium);
    border-radius: var(--radius-full);
    background: var(--neutral-background-medium);
    color: var(--neutral-on-background-medium);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }
  .lightbox__close:hover {
    color: var(--static-white);
    background: var(--neutral-background-strong);
  }
</style>
